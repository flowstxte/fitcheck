# ==============================================================================
# FitCheck Environment Variables Template
# Copy this file to `.env.local` and fill in your actual credentials.
# DO NOT commit `.env.local` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Authentication & Database)
# Find these in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Service role key (SERVER-SIDE ONLY - bypasses RLS for admin queries and DB writes)
# Never expose this on the client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Cloudinary (Image Hosting & Signed Direct Uploads)
# Find these in: Cloudinary Console -> Dashboard / API Keys
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 3. Google Gemini AI (Multimodal Outfit Analysis)
# Get a free API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# 4. Guest Session & Cookie Security
# Generate a 32-byte hex string in your terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
COOKIE_SECRET=your-secure-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# 5. Site Configuration
# Used for metadata, canonical URLs, and dynamic social share-card rendering
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
